# Copy to .env.local and fill in from your Supabase project:
#   Project Settings -> Data API -> Project URL and anon/publishable key.
#
# Leave these unset to run Cartographer local-only: no account, no network, projects
# stored in this browser. Everything works except syncing between machines.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
